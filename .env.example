# === Required API Keys ===
GEMINI_API_KEY=your_gemini_api_key_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_page_access_token_with_publish_permissions

# Use a Page Access Token from Meta Graph API Explorer (not a short-lived User token).
# Required token scopes: instagram_basic, instagram_content_publish,
# pages_read_engagement, pages_show_list

# === Brand Configuration ===
BRAND_NAME=tintix.lab
BRAND_HASHTAG=tintixlab
WATERMARK_TEXT=@tintix.lab

# === Optional Settings ===
# Image hosting URL (if output PNGs are already hosted publicly)
# IMAGE_PUBLIC_BASE_URL=https://your-domain.com/output

# Path to Foda Display font (otherwise place FodaDisplay-Regular.otf in fonts/)
# FODA_DISPLAY_FONT_PATH=/path/to/FodaDisplay-Regular.otf

# Color diversity settings
# MIN_COLOR_DISTANCE=12.0
# PALETTE_HISTORY_SIZE=30
# DUPLICATE_PALETTE_RETRIES=5

# === GitHub Actions Secrets ===
# Add these to your repo: Settings → Secrets → Actions
# - GEMINI_API_KEY
# - INSTAGRAM_ACCOUNT_ID
# - INSTAGRAM_ACCESS_TOKEN
# - BRAND_NAME
# - BRAND_HASHTAG
# - WATERMARK_TEXT

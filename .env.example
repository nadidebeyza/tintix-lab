GEMINI_API_KEY=your_gemini_api_key_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_page_access_token_with_publish_permissions
# Use a Page Access Token from Meta Graph API Explorer (not a short-lived User token).
# GitHub Secrets: paste with no trailing spaces or newlines.
# Required token scopes: instagram_basic, instagram_content_publish,
# pages_read_engagement, pages_show_list
# Optional: if output PNGs are already hosted publicly
# IMAGE_PUBLIC_BASE_URL=https://your-domain.com/output
# Optional: path to Foda Display (otherwise place FodaDisplay-Regular.otf in fonts/)
# FODA_DISPLAY_FONT_PATH=/path/to/FodaDisplay-Regular.otf

# GitHub Actions secrets: GEMINI_API_KEY, INSTAGRAM_ACCOUNT_ID, INSTAGRAM_ACCESS_TOKEN

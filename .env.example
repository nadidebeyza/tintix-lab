GEMINI_API_KEY=your_gemini_api_key_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_page_access_token_with_publish_permissions
# Required token scopes: instagram_basic, instagram_content_publish,
# pages_read_engagement, pages_show_list
# Optional: if output PNGs are already hosted publicly
# IMAGE_PUBLIC_BASE_URL=https://your-domain.com/output

# GitHub Actions: add the three values above as repository secrets
# (Settings → Secrets and variables → Actions → New repository secret)
